---
import { getCollection, getEntry } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import { tldTokens } from '../../lib/tokens';

export async function getStaticPaths() {
  const nodes = await getCollection('nodes');
  return nodes.map((node) => ({ params: { slug: node.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('nodes', slug!);

if (!entry) {
  return Astro.redirect('/404');
}

const node = entry.data;
const tokens = tldTokens.cv;

// Group skills by category
const skillsByCategory = node.skills.reduce<Record<string, typeof node.skills>>((acc, skill) => {
  if (!acc[skill.category]) acc[skill.category] = [];
  acc[skill.category].push(skill);
  return acc;
}, {});
---

<Shell tld="cv" slug={slug!} title={node.displayName}>
  <!-- CV Overview Card -->
  <section class="mb-12">
    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-widest px-2.5 py-1 rounded-full mb-4"
        style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
      >
        {tokens.pow}
      </span>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-bold text-hk mb-1">{node.standardCv.headline}</h1>
          <p class="text-sm text-muted">{node.displayName}</p>
        </div>
        <span
          class="shrink-0 text-xs font-semibold px-3 py-1 rounded-full"
          style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
        >
          {node.availability.status}
        </span>
      </div>
      <div class="flex gap-8 mb-6">
        <div>
          <p class="text-3xl font-bold text-hk" style="font-family: var(--font-mono);">{node.standardCv.yearsExperience}</p>
          <p class="text-xs text-muted mt-0.5">års erfarenhet</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-hk" style="font-family: var(--font-mono);">{node.standardCv.deliveries}</p>
          <p class="text-xs text-muted mt-0.5">leveranser</p>
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Kärnkompetenser</p>
        <div class="flex flex-wrap gap-2">
          {node.standardCv.coreCompetencies.map((c) => (
            <span
              class="text-xs font-medium px-3 py-1.5 rounded-md"
              style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
            >
              {c}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-6">Erfarenhet</h2>
    <div class="relative">
      <div class="absolute left-3 top-0 bottom-0 w-px bg-gray-100"></div>
      <div class="space-y-6">
        {node.experience.map((exp) => (
          <div class="relative pl-10">
            <div
              class="absolute left-1.5 top-1.5 w-3 h-3 rounded-full border-2 bg-white"
              style={`border-color: ${tokens.accentHex};`}
            ></div>
            <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-5">
              <div class="flex items-start justify-between gap-4 mb-2">
                <div>
                  <h3 class="font-semibold text-hk">{exp.role}</h3>
                  <p class="text-sm font-medium" style={`color: ${tokens.accentHex};`}>{exp.company}</p>
                </div>
                <span class="shrink-0 text-xs text-muted" style="font-family: var(--font-mono);">{exp.period}</span>
              </div>
              <p class="text-sm text-muted leading-relaxed">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-6">Skills</h2>
    <div class="space-y-8">
      {Object.entries(skillsByCategory).map(([category, skills]) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-4">{category}</p>
          <div class="space-y-3">
            {skills.map((skill) => (
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-hk">{skill.name}</span>
                  <span class="text-xs text-muted" style="font-family: var(--font-mono);">{skill.level}</span>
                </div>
                <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
                  <div
                    class="h-full rounded-full transition-all"
                    style={`width: ${skill.level}%; background-color: ${tokens.accentHex};`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- AI Matching -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">AI-matchning</h2>
    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
      <p class="text-sm text-muted mb-4">Klistra in en uppdragsbeskrivning för att se hur väl profilen matchar.</p>
      <textarea
        id="match-input"
        class="w-full h-28 text-sm border border-gray-200 rounded-lg px-3 py-2 resize-none focus:outline-none focus:border-gray-300 text-hk placeholder-muted"
        placeholder="Klistra in en uppdragsbeskrivning..."
      ></textarea>
      <button
        id="match-btn"
        class="mt-3 text-sm font-semibold px-5 py-2 rounded-lg text-white transition-opacity hover:opacity-90"
        style={`background-color: ${tokens.accentHex};`}
        onclick="document.getElementById('match-result').classList.remove('hidden')"
      >
        Matcha uppdrag
      </button>
      <div id="match-result" class="hidden mt-5">
        <div
          class="rounded-xl p-5"
          style={`background-color: ${tokens.softBg};`}
        >
          <div class="flex items-center justify-between mb-3">
            <p class="font-semibold text-hk">Matchresultat</p>
            <span class="text-xl font-bold" style={`color: ${tokens.accentHex}; font-family: var(--font-mono);`}>94%</span>
          </div>
          <p class="text-sm text-muted leading-relaxed mb-3">
            Profilen matchar väl mot uppdraget. Nyckelkompetenser som träffar: systemarkitektur, tekniskt ledarskap och AI-infrastruktur.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Systemarkitektur', 'Tech Lead', 'AI-infrastruktur'].map((tag) => (
              <span
                class="text-xs font-medium px-2.5 py-1 rounded-md text-white"
                style={`background-color: ${tokens.accentHex};`}
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Export Row -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Exportera</h2>
    <div class="flex flex-wrap gap-2">
      {[
        { label: 'PDF', icon: '⬇' },
        { label: 'DOCX', icon: '⬇' },
        { label: 'JSON', icon: '{ }' },
        { label: 'Dela', icon: '↗' },
      ].map((btn) => (
        <button
          class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-200 text-hk hover:border-gray-300 transition-colors"
        >
          <span class="text-xs" style="font-family: var(--font-mono);">{btn.icon}</span>
          {btn.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Availability Card -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Tillgänglighet</h2>
    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
      <div class="flex items-center gap-3 mb-3">
        <div
          class="w-2.5 h-2.5 rounded-full"
          style={`background-color: ${tokens.accentHex};`}
        ></div>
        <span class="font-semibold text-hk">{node.availability.status}</span>
      </div>
      <p class="text-sm text-muted">
        Tillgänglig från <span class="font-medium text-hk" style="font-family: var(--font-mono);">{node.availability.from}</span>.
        Baserad i {node.location.city}, {node.location.country}. Tidzon: {node.location.timezone}.
      </p>
      <div class="mt-4 pt-4 border-t border-gray-100">
        {node.links.email && (
          <a
            href={`mailto:${node.links.email}`}
            class="text-sm font-semibold"
            style={`color: ${tokens.accentHex};`}
          >
            Ta kontakt →
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Footer metadata -->
  <footer class="pt-8 border-t border-gray-100">
    <div
      class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-muted"
      style="font-family: var(--font-mono);"
    >
      <span>node/{node.nodeId}</span>
      <span>{node.location.city}, {node.location.country}</span>
      <span>{node.location.timezone}</span>
      <span>type/{node.type}</span>
    </div>
  </footer>
</Shell>
