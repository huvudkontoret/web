---
import '../../../styles/global.css';
import { tldTokens } from '../../../lib/tokens';
import type { TldKey } from '../../../lib/tokens';

export function getStaticPaths() {
  return Object.keys(tldTokens).map((key) => ({ params: { tld: key } }));
}

const { tld } = Astro.params as { tld: TldKey };
const token = tldTokens[tld];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Layer demo — TLD {token.label}</title>
  </head>
  <body style={`background-color: ${token.softBg};`} class="min-h-screen">

    <main class="max-w-2xl mx-auto px-6 py-16">

      <!-- Token card -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

        <!-- Header stripe -->
        <div class="h-2" style={`background-color: ${token.accentHex};`}></div>

        <div class="p-8 space-y-8">

          <!-- Label + role -->
          <div class="flex items-start justify-between">
            <div>
              <div class="text-5xl font-bold tracking-tight" style={`color: ${token.accentHex};`}>
                {token.label}
              </div>
              <div class="mt-1 text-sm text-muted" style="font-family: var(--font-mono);">
                role: {token.role}
              </div>
            </div>
            <div
              class="text-xs font-medium px-3 py-1.5 rounded-full"
              style={`background-color: ${token.softBg}; color: ${token.accentHex};`}
            >
              perspective
            </div>
          </div>

          <!-- POW -->
          <div class="border-l-2 pl-4" style={`border-color: ${token.accentHex};`}>
            <div class="text-xs text-muted mb-1" style="font-family: var(--font-mono);">pow:</div>
            <div class="text-base text-hk">{token.pow}</div>
          </div>

          <!-- Color tokens -->
          <div>
            <div class="text-xs text-muted mb-3" style="font-family: var(--font-mono);">color tokens:</div>
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg border border-gray-100 shrink-0" style={`background-color: ${token.accentHex};`}></div>
                <div>
                  <div class="text-xs font-medium text-hk" style="font-family: var(--font-mono);">accent</div>
                  <div class="text-xs text-muted" style="font-family: var(--font-mono);">{token.accentHex}</div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg border border-gray-100 shrink-0" style={`background-color: ${token.softBg};`}></div>
                <div>
                  <div class="text-xs font-medium text-hk" style="font-family: var(--font-mono);">softBg</div>
                  <div class="text-xs text-muted" style="font-family: var(--font-mono);">{token.softBg}</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sample UI elements -->
          <div>
            <div class="text-xs text-muted mb-3" style="font-family: var(--font-mono);">sample components:</div>
            <div class="space-y-2">
              <button
                class="text-sm font-medium px-4 py-2 rounded-lg text-white"
                style={`background-color: ${token.accentHex};`}
              >
                Primary action
              </button>
              <div class="flex gap-2 flex-wrap">
                {['Tag one', 'Tag two', 'Tag three'].map((tag) => (
                  <span
                    class="text-xs px-2.5 py-1 rounded-full font-medium"
                    style={`background-color: ${token.softBg}; color: ${token.accentHex};`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
              <div
                class="rounded-lg p-4 text-sm"
                style={`background-color: ${token.softBg}; color: ${token.accentHex};`}
              >
                Soft container for highlighted content.
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- TLD nav -->
      <div class="mt-6 flex justify-center gap-2">
        {Object.entries(tldTokens).map(([key, t]) => (
          <a
            href={`/demo/tld/${key}`}
            class="text-xs px-3 py-1.5 rounded-full border transition-colors"
            style={key === tld
              ? `background-color: ${t.accentHex}; color: white; border-color: ${t.accentHex};`
              : 'border-color: #e5e7eb; color: #6b7280;'}
          >
            {t.label}
          </a>
        ))}
      </div>

    </main>

    <!-- Demo nav -->
    <div class="fixed bottom-4 left-1/2 -translate-x-1/2">
      <div class="flex items-center gap-1 bg-white border border-gray-200 rounded-full px-3 py-1.5 shadow-sm text-xs" style="font-family: var(--font-mono);">
        <a href="/demo/shell" class="text-muted hover:text-hk transition-colors">shell</a>
        <span class="text-gray-300 mx-1">·</span>
        <span class="font-semibold text-hk">tld</span>
        <span class="text-gray-300 mx-1">·</span>
        <a href="/demo/slug/magnusrenholm" class="text-muted hover:text-hk transition-colors">slug</a>
        <span class="text-gray-300 mx-1">·</span>
        <a href={`/${tld}/magnusrenholm`} class="text-muted hover:text-hk transition-colors">full</a>
      </div>
    </div>

  </body>
</html>
