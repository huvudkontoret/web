---
import { getCollection, getEntry } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import { tldTokens } from '../../lib/tokens';

export async function getStaticPaths() {
  const nodes = await getCollection('nodes');
  return nodes.map((node) => ({ params: { slug: node.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('nodes', slug!);

if (!entry) {
  return Astro.redirect('/404');
}

const node = entry.data;
const tokens = tldTokens.name;
---

<Shell tld="name" slug={slug!} title={node.displayName}>
  <!-- Hero -->
  <section class="mb-12">
    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-widest px-2.5 py-1 rounded-full mb-4"
        style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
      >
        {tokens.pow}
      </span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-hk mb-3">
      {node.displayName}
    </h1>
    <p class="text-lg text-muted mb-4" style="font-family: var(--font-mono);">{node.title}</p>
    <div class="flex items-center gap-2 mb-6">
      <span class="inline-flex items-center gap-1.5 text-sm text-muted border border-gray-200 rounded-full px-3 py-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        {node.location.city}, {node.location.country}
      </span>
      <span
        class="inline-block text-xs font-medium px-3 py-1 rounded-full"
        style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
      >
        {node.availability.status} {node.availability.from}
      </span>
    </div>
    <p class="text-xl text-hk leading-relaxed max-w-2xl">{node.summary}</p>
  </section>

  <!-- Bio -->
  <section class="mb-12">
    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Om mig</h2>
      <p class="text-base leading-relaxed text-hk">{node.bio}</p>
    </div>
  </section>

  <!-- Current Focus -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Just nu</h2>
    <div class="flex flex-wrap gap-2">
      {node.currentFocus.map((focus) => (
        <span
          class="text-sm font-medium px-4 py-2 rounded-full"
          style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex};`}
        >
          {focus}
        </span>
      ))}
    </div>
  </section>

  <!-- Principles -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-6">Principer</h2>
    <ol class="space-y-3">
      {node.principles.map((p, i) => (
        <li class="flex items-start gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold"
            style={`background-color: ${tokens.softBg}; color: ${tokens.accentHex}; font-family: var(--font-mono);`}
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="text-base leading-relaxed text-hk pt-0.5">{p}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- Embedded CV Card -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Kapabilitet</h2>
    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <p class="text-xs text-muted mb-1" style="font-family: var(--font-mono);">.cv</p>
          <h3 class="text-lg font-semibold text-hk">{node.standardCv.headline}</h3>
        </div>
        <a
          href={`/cv/${slug}`}
          class="shrink-0 text-xs font-semibold px-3 py-1.5 rounded-lg text-white"
          style={`background-color: ${tldTokens.cv.accentHex};`}
        >
          Se fullt CV
        </a>
      </div>
      <div class="flex gap-6 mb-4">
        <div>
          <p class="text-2xl font-bold text-hk" style="font-family: var(--font-mono);">{node.standardCv.yearsExperience}</p>
          <p class="text-xs text-muted">års erfarenhet</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-hk" style="font-family: var(--font-mono);">{node.standardCv.deliveries}</p>
          <p class="text-xs text-muted">leveranser</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {node.standardCv.coreCompetencies.slice(0, 4).map((c) => (
          <span class="text-xs px-2.5 py-1 rounded-md bg-gray-50 border border-gray-100 text-muted">
            {c}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Links -->
  <section class="mb-12">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-4">Kontakt</h2>
    <div class="flex flex-wrap gap-3">
      {node.links.linkedin && (
        <a
          href={node.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-200 text-hk hover:border-gray-300 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
      )}
      {node.links.email && (
        <a
          href={`mailto:${node.links.email}`}
          class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-200 text-hk hover:border-gray-300 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          E-post
        </a>
      )}
    </div>
  </section>

  <!-- Footer metadata -->
  <footer class="pt-8 border-t border-gray-100">
    <div
      class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-muted"
      style="font-family: var(--font-mono);"
    >
      <span>node/{node.nodeId}</span>
      <span>{node.location.city}, {node.location.country}</span>
      <span>{node.location.timezone}</span>
      <span>type/{node.type}</span>
    </div>
  </footer>
</Shell>
