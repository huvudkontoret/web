{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  // The site is the repo root. What actually gets published is narrowed by
  // .assetsignore — without it the whole checkout is served, agent
  // instructions and design docs included.
  "assets": {
    "directory": "."
    // not_found_handling is deliberately unset: the default returns a plain
    // 404, which is what GitHub Pages does here today (custom_404: false).
    // Setting "404-page" would need a 404.html this site does not have.
  },
  // `wrangler deploy` creates the custom domains it finds here, so this route
  // *is* the cutover: the apex leaves GitHub Pages the moment the production
  // build runs after this merges. That is why it arrived as its own pull
  // request, together with expectCustomDomain in tools/check/facts.json — the
  // gate fails on one without the other, so the cutover can neither turn up as
  // a side effect of an unrelated change nor quietly disappear afterwards.
  //
  // www keeps its 301 to the apex through a zone redirect rule rather than a
  // second custom domain — this Worker has no script and cannot redirect on
  // its own. See docs/runbooks/2026-08-12-pages-to-workers-cutover.md.
  "routes": [{ "pattern": "huvudkontoret.io", "custom_domain": true }],
  // Every pull request gets a preview at <branch>-web.<subdomain>.workers.dev.
  // Restricted with Cloudflare Access — the previews show unreleased work.
  "preview_urls": true
}
