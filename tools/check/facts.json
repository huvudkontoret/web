{
  "surfaces": ["index.html", "index.md", "llms.txt"],

  "sharedFacts": [
    { "label": "contact address", "match": "hej@huvudkontoret.io" },
    { "label": "Hanna Wikman", "match": "Hanna Wikman" },
    { "label": "Magnus Renholm", "match": "Magnus Renholm" },
    { "label": "Sebastian Berglönn", "match": "Sebastian Berglönn" }
  ],

  "addressesNotInService": [".ai", ".app", ".vote"],
  "inServiceMarkers": ["Snart", "inte i drift", "inte tillgänglig", "ännu inte", "kommer"],

  "licensedFontPattern": "^assets/fonts/.+\\.woff2$",

  "requiredFiles": ["CNAME", ".nojekyll", "index.html", "index.md", "llms.txt", "robots.txt", "sitemap.xml"],

  "publishedPaths": [
    "index.html",
    "index.md",
    "llms.txt",
    "llms-full.txt",
    "robots.txt",
    "sitemap.xml",
    ".well-known/",
    "assets/"
  ],
  "requiredPublished": ["index.html", "index.md", "llms.txt", "robots.txt", "sitemap.xml"],

  "//sitemapPages": "The pages sitemap.xml has to advertise, as repo paths; index.html is the root URL. robots.txt names the sitemap as the crawl entry point and llms-full.txt is linked from nowhere else on the site, so a surface left out of this list is published and undiscoverable at once. robots.txt, sitemap.xml and assets/ are published without being pages and are deliberately absent.",
  "sitemapPages": [
    "index.html",
    "index.md",
    "llms.txt",
    "llms-full.txt",
    ".well-known/agent-skills/index.json",
    ".well-known/api-catalog"
  ],

  "expectedCname": "huvudkontoret.io",

  "//expectCustomDomain": "false until the cutover. Flipping this and adding the route to wrangler.jsonc are the same decision, and the gate fails on one without the other. See docs/runbooks/2026-08-12-pages-to-workers-cutover.md.",
  "expectCustomDomain": false,

  "contentSignal": "ai-train=no",
  "neverPublished": ["^dist/", "^node_modules/", "^\\.astro/", "\\.env$", "^\\.wrangler/"],

  "textFileExtensions": [".html", ".md", ".txt", ".json", ".xml", ".svg", ".mjs", ".js", ".yml", ".yaml", ".jsonc"],

  "formattingIgnore": ["^assets/"]
}
